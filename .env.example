# Copy this file to .env.local and fill in the values from your Supabase project.
# Dashboard -> Connect -> Framework -> Next.js, or Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Use whichever key your project shows - both names are accepted.
# Newer projects: a "publishable" key that looks like sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: the "anon public" key, a JWT starting with eyJ...
NEXT_PUBLIC_SUPABASE_ANON_KEY=
